#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# Created in the personal fork on 2026-10-30: bootstrap the standalone release installer without a checkout.
# scripts/release-assets.py appends the original Python implementation and its notices.
set -euo pipefail
if [[ ${EUID} == 0 ]]; then
    echo 'Run this installer as your normal desktop user, without sudo.' >&2
    exit 1
fi
python_command=$(command -v python3 || true)
if [[ $(uname -s) == Darwin ]]; then
    for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3; do
        if [[ -x "$candidate" ]]; then python_command=$candidate; break; fi
    done
fi
if [[ -z "$python_command" ]] || ! "$python_command" -c 'import sys; sys.exit(sys.version_info < (3, 10))'; then
    if [[ $(uname -s) == Darwin ]]; then
        brew_command=$(command -v brew || true)
        for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
            if [[ -x "$candidate" ]]; then brew_command=$candidate; break; fi
        done
        if [[ -z "$brew_command" ]]; then
            echo 'Homebrew is required. Follow https://brew.sh, then rerun this command.' >&2
            exit 1
        fi
        printf -v commands '%q install python' "$brew_command"
    else
        # Parse data without sourcing /etc/os-release as shell code.
        distro=$(sed -n 's/^ID=//p' /etc/os-release | tr -d '\"')
        distro_version=$(sed -n 's/^VERSION_ID=//p' /etc/os-release | tr -d '\"')
        case "$distro:$distro_version:$(uname -m)" in
            ubuntu:22.04:x86_64|ubuntu:24.04:x86_64|ubuntu:24.04:aarch64|debian:12:x86_64|debian:13:x86_64)
                commands='sudo apt-get update && sudo apt-get install -y python3 ca-certificates' ;;
            fedora:43:x86_64) commands='sudo dnf install -y python3 ca-certificates' ;;
            arch:*:x86_64) commands='sudo pacman -Syu --needed --noconfirm python ca-certificates' ;;
            *) echo 'No verified bootstrap for this platform.' >&2; exit 1 ;;
        esac
    fi
    printf 'Missing Python 3.10+. Required operations: %s\n' "$commands"
    approved=false
    for arg in "$@"; do if [[ "$arg" == --yes ]]; then approved=true; fi; done
    if [[ "$approved" != true ]]; then
        read -r -p 'Proceed? [y/N] ' answer </dev/tty
        [[ "$answer" == y || "$answer" == Y || "$answer" == yes ]] || exit 1
    fi
    # The command is selected exclusively from the literal cases above.
    bash -c "$commands"
    if [[ $(uname -s) == Darwin ]]; then
        python_command="$("$brew_command" --prefix)/bin/python3"
    else
        python_command=/usr/bin/python3
    fi
    "$python_command" -c 'import sys; sys.exit(sys.version_info < (3, 10))' || {
        echo 'Python 3.10+ is still unavailable; fix the dependency and rerun.' >&2; exit 1;
    }
fi
installer_work=$(mktemp -d "${TMPDIR:-/tmp}/ase-installer.XXXXXXXX")
trap 'rm -rf -- "$installer_work"' EXIT
cat > "$installer_work/versioning.py" <<'ASE_VERSION_PYTHON'
